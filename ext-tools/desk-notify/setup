#!/usr/bin/env bash
set -euo pipefail

# setup: non-interactive setup commands, called through
# `scripts/ext-tool.sh setup <team> <name> desk-notify <command>`.
# desk-notify has no settings and no secrets; `save` only writes the member
# config that join requires.
#
# Usage:
#   setup status <config_path>
#   setup check notifier
#   setup save <config_path>
#   setup test <config_path>

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
. "$SCRIPT_DIR/_lib.sh"

die() { echo "setup: $*" >&2; exit 1; }

cmd="${1:-}"
[ -n "$cmd" ] || die "usage: setup status|check|save|test ..."
shift

case "$cmd" in
  status)
    config_path="${1:?usage: setup status <config_path>}"
    if [ -f "$config_path" ]; then
      echo '{"missing":[],"configured":true}'
    else
      echo '{"missing":[],"configured":false}'
    fi
    ;;
  check)
    [ "${1:-}" = "notifier" ] || die "unknown check: ${1:-} (expected notifier)"
    notifier="$(desk_notify_notifier)"
    [ -n "$notifier" ] || die "no desktop notifier on this machine (needs osascript on macOS or notify-send on Linux)"
    printf '{"ok":true,"notifier":"%s"}\n' "$notifier"
    ;;
  save)
    config_path="${1:?usage: setup save <config_path>}"
    mkdir -p "$(dirname "$config_path")"
    umask 077
    printf 'tool=desk-notify\n' > "$config_path"
    chmod 600 "$config_path"
    printf '{"ok":true,"config_path":"%s"}\n' "$config_path"
    ;;
  test)
    config_path="${1:?usage: setup test <config_path>}"
    [ -f "$config_path" ] || die "not configured yet: run save first"
    desk_notify_show "agmsg: desk-notify" "Test notification. Messages sent to this member will show up like this."
    echo '{"ok":true}'
    ;;
  *)
    die "unknown command: $cmd (expected status, check, save, or test)"
    ;;
esac
